# Secrets — never commit real keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime artifacts
logs/
*.log

# Tournament state: ignore local noise, but track the canonical state file so
# the GitHub Action can persist the tournament across daily runs.
state/*
!state/tournament.json

# OS / editor
.DS_Store
.idea/
.vscode/
