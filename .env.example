# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Alpaca (personal account, API-key auth) -------------------------------
# Create paper-trading keys at https://app.alpaca.markets  (Paper Trading -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true  -> paper account (https://paper-api.alpaca.markets)  [SAFE DEFAULT]
# false -> LIVE account, real money
ALPACA_PAPER=true

# --- Alpaca Broker API (sandbox) — 10-account tournament -------------------
# Broker API key ID + secret from the Alpaca Broker dashboard (sandbox). Used
# to create, fund, and trade the 10 per-model sub-accounts. Separate from the
# retail paper keys above.
CLIENT_ID=
CLIENT_SECRET=

# --- AI decision model -----------------------------------------------------
# claude  -> Anthropic Claude (reference implementation)
# openai  -> OpenAI (install extra: pip install '.[openai]')
AI_PROVIDER=claude

# Anthropic. The SDK also reads ANTHROPIC_API_KEY from the environment directly;
# setting it here wires it through the app config as well.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# OpenAI (only needed when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Watchlist -------------------------------------------------------------
SYMBOLS=AAPL,MSFT,SPY
BAR_LOOKBACK_DAYS=30

# --- Risk guardrails (USD) -------------------------------------------------
MAX_TRADE_NOTIONAL=1000      # max $ per single order
MAX_POSITION_NOTIONAL=5000   # max $ held in any one symbol
MAX_DAILY_LOSS=500           # halt new buys once the day is down this much
MIN_CONFIDENCE=0.6           # model confidence required to act (0..1)

# --- Safety ----------------------------------------------------------------
# true  -> decide and log, but NEVER submit orders  [SAFE DEFAULT]
# false -> actually submit orders (still paper unless ALPACA_PAPER=false)
DRY_RUN=true

# --- Tournament (multi-model competition; see README) ----------------------
# All ledgers are simulated — no real orders are ever placed by the tournament.
# Contestants using Claude need ANTHROPIC_API_KEY; OpenAI contestants need OPENAI_API_KEY.
TOURNAMENT_CAPITAL=100              # starting virtual $ per contestant
TOURNAMENT_SLIPPAGE_BPS=5          # simulated trade cost (basis points)
TOURNAMENT_ELIMINATION_DAYS=7      # a "week": drop the worst every N days...
TOURNAMENT_GRACE_DAYS=21           # ...but not for the first N days (first cut in week 4)
TOURNAMENT_SAFE_WEEKLY_RETURN=5    # if your weekly return exceeds this %, you're safe that week
TOURNAMENT_MAX_DAILY_SPEND=5       # abort a run once real API spend hits this many $
TOURNAMENT_MIN_CONFIDENCE=0.55     # model confidence required to act
